{
  "manifest_version": 3,
  "name": "Box Auto-Login & Session Keeper",
  "version": "1.1.0",
  "description": "Automatically keeps Box sessions awake and silently logs back in if disconnected.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.box.com/*",
    "https://*.app.box.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Box Auto-Login Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.app.box.com/*",
        "https://*.box.com/*"
      ],
      "exclude_matches": [
        "https://account.box.com/*",
        "https://*.box.com/login*"
      ],
      "js": ["keepalive.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://account.box.com/*",
        "https://*.app.box.com/login*",
        "https://*.box.com/login*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
